<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TPTP | Texas Prison Transparency Project</title>
  <meta name="description" content="Promoting Transparency, Accountability, and Rehabilitation in the Texas Prison System" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Montserrat:wght@700;800&display=swap" rel="stylesheet">
  <style>
    :root{
      --primary:#0B3A6A;
      --accent:#CBA135;
      --dark:#0F172A;
      --light:#F8FAFC;
      --text:#0f172a;
      --muted:#334155;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      color:var(--text);
      background:#ffffff;
      line-height:1.5;
    }
    a{color:var(--primary);text-decoration:none}
    a:hover{text-decoration:underline}
    /* Nav */
    .nav{
      position:sticky;top:0;z-index:50;
      backdrop-filter:saturate(180%) blur(8px);
      background:rgba(255,255,255,.9);
      border-bottom:1px solid #e5e7eb;
    }
    .nav-inner{
      max-width:1200px;margin:0 auto;
      display:flex;align-items:center;justify-content:space-between;
      padding:12px 20px;
    }
    .brand{font-family:Montserrat,Inter,sans-serif;font-weight:800;color:var(--primary)}
    .menu{display:flex;gap:18px;flex-wrap:wrap}
    .menu a{font-weight:500;color:var(--dark)}
    .menu a:hover{color:var(--primary)}
    /* Hero */
    .hero{
      background:linear-gradient(180deg,#0B3A6A 0%,#0F172A 100%);
      color:#fff;
      text-align:center;
      padding:120px 20px;
    }
    .hero h1{
      font-family:Montserrat,Inter,sans-serif;
      font-size:44px;line-height:1.15;margin:0 0 10px;
    }
    .hero p{opacity:.9;max-width:900px;margin:0 auto 16px}
    .tagline{font-size:22px;font-weight:600;color:#fff;margin-top:8px}
    .btn{
      display:inline-block;border:0;cursor:pointer;
      padding:12px 18px;border-radius:8px;font-weight:600;
    }
    .btn-primary{background:var(--accent);color:var(--dark)}
    .btn-outline{
      color:#fff;border:2px solid #fff;background:transparent;
    }
    .stack{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
    /* Sections */
    section{padding:72px 20px}
    .wrap{max-width:1200px;margin:0 auto}
    .narrow{max-width:900px;margin:0 auto}
    .light{background:var(--light)}
    h2{
      font-family:Montserrat,Inter,sans-serif;
      font-size:32px;margin:0 0 14px;color:var(--dark);
    }
    .divider{
      width:120px;height:1px;background:var(--accent);
      margin:16px 0 24px;
    }
    /* Columns */
    .cols{
      display:grid;gap:28px;grid-template-columns:1fr;
    }
    @media(min-width:900px){
      .cols{grid-template-columns:1fr 1fr}
    }
    .card{
      background:#fff;border-radius:16px;
      box-shadow:0 6px 24px rgba(2,6,23,.08);
      padding:22px;border-left:4px solid var(--accent);
    }
    ul{padding-left:18px;margin:0}
    /* Grid cards */
    .grid{display:grid;gap:18px}
    @media(min-width:900px){
      .grid{grid-template-columns:repeat(3,1fr)}
    }
    .proj{background:#fff;border-radius:16px;border:1px solid #e5e7eb;padding:18px}
    .proj h3{margin:0 0 8px;color:var(--primary)}
    /* Get involved */
    .cta{background:var(--primary);color:#fff}
    .cta h2{color:#fff}
    .cta .btn-primary{background:var(--accent);color:var(--dark)}
    .cta .btn-outline{border-color:#fff}
    /* Contact */
    .contact-list{list-style:none;padding:0;margin:0}
    .contact-list li{margin:6px 0}
    /* Footer */
    footer{
      background:var(--dark);color:#fff;padding:20px;
      border-top:2px solid var(--accent);text-align:center
    }
    /* Bios */
    .bio{margin-bottom:26px}
    .goldrule{height:1px;background:var(--accent);width:160px;margin:14px 0 22px}
    /* Small tweaks */
    .spacer{height:6px}
  </style>
</head>
